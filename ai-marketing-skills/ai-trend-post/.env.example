# AI Trend Post — environment variables
# Copy to .env or ~/.ai-trend-post.env and fill in your values

# Required
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: DALL-E 3 image generation
OPENAI_API_KEY=your_openai_key_here

# Optional: live news search via Tavily (falls back to RSS if not set)
TAVILY_API_KEY=your_tavily_key_here

# Optional: override output directory (default: ./output)
# POST_OUTPUT_DIR=/path/to/output

# Optional: timezone label used in logs (default: UTC)
# POST_TIMEZONE=America/New_York
