# Anthropic Claude API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key for DALL·E image generation — get yours at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Output directory for generated posts and images
OUTPUT_DIR=./output

# (Optional) Set to true to use AI to generate fresh post copy each run
# Set to false to use the pre-written posts in posts-content.json
USE_AI_GENERATION=false
