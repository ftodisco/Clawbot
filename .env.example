# ─────────────────────────────────────────────
#  Clawbot YouTube Automation — Environment
# ─────────────────────────────────────────────

# ── AI Provider (pick one) ────────────────────
# Option A: OpenRouter (access any model — Claude, GPT-4, Gemini, Llama, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Primary model (used first)
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
# Fallback model (used if primary fails)
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.5-flash-02-23

# Option B: Anthropic direct (if OPENROUTER_API_KEY is not set, this is used)
# Get yours at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# YouTube upload visibility: public | unlisted | private
UPLOAD_PRIVACY=public

# Override the daily upload schedule (cron format, UTC)
# Default from config/niche.json: "0 9 * * *" = 9:00 AM UTC daily
# UPLOAD_SCHEDULE=0 9 * * *

# Skip YouTube upload — just generate content/video locally
# DRY_RUN=true

# Optional: fal.ai for AI-generated video (replaces static thumbnail)
# Get your key at: https://fal.ai/dashboard/keys
# FAL_API_KEY=your_key_id:your_key_secret

# Optional: ElevenLabs for higher-quality TTS
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
