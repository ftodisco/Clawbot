# ─────────────────────────────────────────────
#  Clawbot YouTube Automation — Environment
# ─────────────────────────────────────────────

# ── AI Provider (pick one) ────────────────────
# Option A: OpenRouter (access any model — Claude, GPT-4, Gemini, Llama, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Model to use via OpenRouter (default: anthropic/claude-opus-4)
# Examples: anthropic/claude-sonnet-4-5  |  openai/gpt-4o  |  google/gemini-pro
# Browse all: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-opus-4

# Option B: Anthropic direct (if OPENROUTER_API_KEY is not set, this is used)
# Get yours at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# YouTube upload visibility: public | unlisted | private
UPLOAD_PRIVACY=public

# Override the daily upload schedule (cron format, UTC)
# Default from config/niche.json: "0 9 * * *" = 9:00 AM UTC daily
# UPLOAD_SCHEDULE=0 9 * * *

# Skip YouTube upload — just generate content/video locally
# DRY_RUN=true

# Optional: ElevenLabs for higher-quality TTS
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
